{
  "name": "football-api",
  "version": "1.0.0",
  "description": "Football API with NestJS, MikroORM and Hexagonal Architecture",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "mikro-orm": "mikro-orm",
    "migration:create": "dotenv -e .env.local -- mikro-orm migration:create --name=$npm_config_name",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "dotenv -e .env.local -- mikro-orm migration:down",
    "review": "node scripts/review.js"
  },
  "dependencies": {
    "@mikro-orm/cli": "^6.3.0",
    "@mikro-orm/core": "^6.3.0",
    "@mikro-orm/migrations": "^6.3.0",
    "@mikro-orm/nestjs": "^6.0.2",
    "@mikro-orm/postgresql": "^6.3.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "stripe": "^20.4.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/genai": "^1.47.0",
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@octokit/rest": "^21.0.2",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/stripe": "^8.0.416",
    "@types/uuid": "^9.0.7",
    "dotenv-cli": "^11.0.0",
    "openai": "^4.77.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/shared/infrastructure/database/mikro-orm.config.ts"
    ]
  }
}
